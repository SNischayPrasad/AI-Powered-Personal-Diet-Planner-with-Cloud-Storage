# Frontend configuration (Vite exposes only variables prefixed with VITE_).
# Copy to frontend/.env if you need to change a default.

# Leave empty when the API is on the same domain (local dev via the Vite proxy, Vercel,
# or the single-container Docker/Render deployment). Set it when the API is hosted
# separately, e.g. https://diet-planner-api.onrender.com
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api during `npm run dev`.
VITE_DEV_API_PROXY=http://localhost:8000
