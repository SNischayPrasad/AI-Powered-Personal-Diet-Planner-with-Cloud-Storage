# =============================================================================
# AI-Powered Personal Diet Planner — environment configuration
#
# 1. Copy this file:   cp .env.example .env     (Windows: copy .env.example .env)
# 2. Fill in values.   NEVER commit .env — it is listed in .gitignore.
#
# Every value has a safe local default, so the app runs with an empty .env.
# In the cloud, set these as environment variables in your hosting dashboard
# (Render / Vercel / AWS / Azure / GCP) instead of uploading a .env file.
# =============================================================================

# --- Application ---------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=text                  # text (readable) | json (for cloud log services)

# --- Security --------------------------------------------------------------------
# Secret used to sign login tokens (JWT). REQUIRED in production (>= 32 chars).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when running behind a load balancer/CDN (Render, Vercel, AWS ALB) so rate
# limiting uses the real client IP from X-Forwarded-For.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERATE_PER_MINUTE=20

# --- Cloud database ------------------------------------------------------------------
# Local: SQLite file (created automatically). Relative paths resolve from the project root.
DATABASE_URL=sqlite:///./data/diet_planner.db
# Cloud examples (PostgreSQL):
#   Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Neon:     postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
#   AWS RDS:  postgresql://<user>:<password>@<instance>.<region>.rds.amazonaws.com:5432/dietplanner
#   Docker:   postgresql://dietplanner:<POSTGRES_PASSWORD>@localhost:5432/dietplanner
# Connections per app instance = DB_POOL_SIZE + DB_MAX_OVERFLOW. On serverless hosts use the
# provider's pooled connection string and small values (e.g. 1 and 0).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Cloud object storage -------------------------------------------------------------
# local = simulated bucket on disk (./data/object_storage) | s3 = any S3-compatible service
STORAGE_PROVIDER=local
STORAGE_BUCKET=diet-planner-files
LOCAL_STORAGE_DIR=./data/object_storage
MAX_UPLOAD_MB=4
MAX_FILES_PER_USER=50
# Only needed when STORAGE_PROVIDER=s3:
#   AWS S3:           leave S3_ENDPOINT_URL empty; on AWS prefer an IAM role over keys
#   Supabase Storage: S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   Cloudflare R2:    S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   Docker (RustFS):  S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false        # true for Supabase Storage, R2 and the Docker S3 server

# --- AI diet planner -----------------------------------------------------------------
# rule_based (default, free, offline) | anthropic (Claude) | openai_compatible
# If the AI provider fails for any reason the rule-based engine is used automatically.
AI_PROVIDER=rule_based
AI_EFFORT=low                    # low | medium | high; empty for models without effort support
AI_TIMEOUT_SECONDS=45

# Claude (https://console.anthropic.com):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Any OpenAI-compatible Chat Completions API, for example:
#   Google Gemini (free tier): https://generativelanguage.googleapis.com/v1beta/openai
#   Groq (free tier):          https://api.groq.com/openai/v1
#   Ollama (local, free):      http://localhost:11434/v1   (API key can be left empty)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Local cloud simulation with Docker (docker compose up) ------------------------------------
# Choose your own local-only passwords; docker-compose.yml refuses to start without them.
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# --- Observability / hosting -------------------------------------------------------------
METRICS_ENABLED=true
# Serve the built React app from the API (single-container deployments, e.g. Render/Docker).
FRONTEND_DIST_DIR=
