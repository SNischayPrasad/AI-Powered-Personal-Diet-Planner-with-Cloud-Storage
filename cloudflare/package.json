{
  "name": "ai-diet-planner-cloudflare",
  "private": true,
  "description": "Cloudflare Worker that serves the React app and proxies /api to the FastAPI service",
  "type": "module",
  "scripts": {
    "build": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  },
  "engines": {
    "node": ">=22"
  }
}
